DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/universe_dev
# At least 32 bytes. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_output_of_the_command_above
# Comma-separated dashboard origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used by the AI scripts (app/ai/prototypes/*) when run with --camera-id.
UNIVERSE_API_BASE=http://127.0.0.1:8000
UNIVERSE_API_USERNAME=operator
UNIVERSE_API_PASSWORD=your_operator_password_here
