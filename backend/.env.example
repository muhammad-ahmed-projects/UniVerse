DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/universe_dev
# At least 32 bytes. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_output_of_the_command_above
# Comma-separated dashboard origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evidence snapshots and registered-face thumbnails are stored here
# (default: backend/media, gitignored).
MEDIA_DIR=
# Evidence images older than this many days are deleted (0 = keep forever).
EVIDENCE_RETENTION_DAYS=30

# Used by the AI scripts (app/ai/prototypes/*) when run with --camera-id.
# ai_service is the scripts' service account (created by app.db.seed); it is
# the only non-admin role allowed to read face embeddings.
UNIVERSE_API_BASE=http://127.0.0.1:8000
UNIVERSE_API_USERNAME=ai_service
UNIVERSE_API_PASSWORD=your_ai_service_password_here
